# ── Server ──────────────────────────────────────────
ECO_ADDR=:8080
ECO_ENV=development                 # development | production
ECO_DB_PATH=./data/eco.db
ECO_STORAGE_DIR=./data/media        # uploaded images (outside the DB)
ECO_MAX_UPLOAD_MB=10
ECO_CORS_ORIGINS=*                  # comma-separated; restrict in production
ECO_SESSION_TTL_HOURS=720
ECO_RATE_LIMIT_PER_MIN=120          # per IP; auth endpoints use a stricter built-in limit

# ── First admin (created on startup if no admin exists) ──
ECO_ADMIN_EMAIL=
ECO_ADMIN_PASSWORD=

# ── AI provider (OpenAI-compatible: OpenAI, OpenRouter, Ollama /v1, vLLM, ...) ──
# Leave empty to run without AI: map, observations, review, FTS retrieval, simulation still work.
ECO_AI_BASE_URL=
ECO_AI_API_KEY=
ECO_AI_TEXT_MODEL=
ECO_AI_VISION_MODEL=                # empty -> reuse text model if it supports images, else vision disabled
ECO_AI_EMBEDDING_MODEL=
ECO_AI_EMBEDDING_DIM=               # required with embedding model (e.g. 1536)
ECO_AI_TIMEOUT_SECONDS=60

# ── RSS scheduler ──────────────────────────────────
ECO_RSS_ENABLED=true
ECO_RSS_DEFAULT_INTERVAL_MINUTES=60
ECO_RSS_FETCH_TIMEOUT_SECONDS=20
ECO_RSS_USER_AGENT=EcoTerminal/1.0 (+https://github.com/BugraAkdemir/eco-terminal)

# ── Climate data (Open-Meteo Historical API, ERA5-based, keyless) ──
ECO_CLIMATE_BASE_URL=https://archive-api.open-meteo.com/v1/archive
ECO_CLIMATE_TIMEOUT_SECONDS=60
# Offline ERA5 snapshot used before the network (empty -> auto-search ./datasets, ../datasets, next to the binary)
ECO_CLIMATE_SNAPSHOT=

# ── Demo data ──────────────────────────────────────
ECO_SEED_DEMO=false                 # true -> insert clearly-flagged (is_demo=1) sample observations
